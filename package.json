{
  "name": "talent-insight-vietnam",
  "version": "1.0.0",
  "private": true,
  "description": "Vietnam Tech, Consumer Finance (CFC) & Banking Talent Market Intelligence Platform",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web run start",
    "crawl:live": "PYTHONPATH=crawler .venv/bin/python -m talent_crawler.cli init-live",
    "crawl:update": "PYTHONPATH=crawler .venv/bin/python -m talent_crawler.cli crawl --source company_ats,vietnamworks,topdev,careerviet,careerlink,vn_news_rss",
    "seed": "PYTHONPATH=crawler .venv/bin/python -m talent_crawler.cli seed --reset",
    "test:crawler": "PYTHONPATH=crawler .venv/bin/pytest -v crawler/tests"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
